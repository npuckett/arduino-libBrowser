{
  "name": "arduino-libraries-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing the Arduino Library Manager catalog for AI agents to search.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "arduino-libraries-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "tsx": "^4.22.4",
    "typescript": "^5.4.0"
  }
}
